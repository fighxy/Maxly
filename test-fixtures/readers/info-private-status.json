{
  "kind": "info",
  "name": "info-private-status",
  "description": "Строка «Прочитано»/«Доставлено» на экране сведений: только своё отправленное сообщение в личном чате, по отметке собеседника.",
  "cases": [
    {
      "name": "read-equal",
      "chat": {
        "id": "c1",
        "type": "DIALOG"
      },
      "own": true,
      "state": "sent",
      "messageTime": 5000,
      "peerMark": 5000,
      "expect": {
        "status": "read",
        "text": "Прочитано"
      }
    },
    {
      "name": "read-later",
      "chat": {
        "id": "c1",
        "type": "DIALOG"
      },
      "own": true,
      "state": "sent",
      "messageTime": 5000,
      "peerMark": 9000,
      "expect": {
        "status": "read",
        "text": "Прочитано"
      }
    },
    {
      "name": "delivered-earlier",
      "chat": {
        "id": "c1",
        "type": "DIALOG"
      },
      "own": true,
      "state": "sent",
      "messageTime": 5000,
      "peerMark": 4999,
      "expect": {
        "status": "delivered",
        "text": "Доставлено"
      }
    },
    {
      "name": "delivered-no-mark",
      "chat": {
        "id": "c1",
        "type": "DIALOG"
      },
      "own": true,
      "state": "sent",
      "messageTime": 5000,
      "peerMark": 0,
