    {
      "at": 30000,
      "push": {
        "chatId": "c1",
        "userId": "1"
      }
    },
    {
      "at": 30000,
      "push": {
        "chatId": "c2",
        "userId": "2",
        "type": ""
      }
    },
    {
      "at": 30000,
      "push": {
        "chatId": "c3",
        "userId": "3",
        "type": "DRAWING"
      }
    },
    {
      "at": 30000,
      "expect": {
        "c1": [
          {
            "userId": "1",
