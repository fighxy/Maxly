      "expect": {
        "c1": [
          {
            "userId": "1",
            "type": "TEXT"
          }
        ]
      }
    },
    {
      "at": 8000,
      "expect": {
        "c1": [
          {
            "userId": "1",
            "type": "TEXT"
          }
        ]
      }
    },
    {
      "at": 8001,
      "expect": {}
    },
    {
      "at": 10000,
      "push": {
        "chatId": "c1",
        "userId": "1",
        "type": "TEXT"
      }
    },
    {
      "at": 15000,
      "push": {
        "chatId": "c1",
        "userId": "1",
        "type": "STICKER"
      }
    },
    {
      "at": 18001,
      "expect": {
        "c1": [
          {
            "userId": "1",
            "type": "STICKER"
          }
        ]
      }
